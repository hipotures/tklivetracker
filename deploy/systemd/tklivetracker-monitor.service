[Unit]
Description=TkLiveTracker Selenium monitor
PartOf=tklivetracker.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__UV_PATH__ run python scripts/selenium_live_monitor.py --config __INSTALL_DIR__/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=tklivetracker.target
